# All geometry commands must precede /run/initialize.
/cupid/geometry/enable Cryostat
/cupid/geometry/enable InnerShielding
/cupid/geometry/enable LMOArray
/cupid/geometry/lmoCount 1
/cupid/geometry/list
/run/initialize
# Requires an interactive session or the --vis option.
/vis/open OGL
/vis/drawVolume
/vis/viewer/set/viewpointVector 1 0.3 1
/vis/viewer/set/style surface
/vis/viewer/set/background white
/vis/scene/add/axes 0 0 0 250 mm
/vis/viewer/set/autoRefresh true
/vis/viewer/flush

